# Copy to .env and fill in. Never commit the real .env.
# cp .env.example .env

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Which block of `llm:` in src/config/configuration.yaml to load.
# One of: openai | google | groq
LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# LLM API keys — only the one matching LLM_PROVIDER is required.
# Embeddings are OpenAI-backed, so OPENAI_API_KEY is read regardless.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Web search (required) — https://tavily.com
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-key-here

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Absolute or project-relative path to the YAML config.
# Defaults to src/config/configuration.yaml
# CONFIG_PATH=src/config/configuration.yaml

# Port the container listens on (see Dockerfile).
# PORT=8000
